# Optional: Alchemy RPC key for a dedicated Starknet provider.
# Without it the app uses the public Cartridge Starknet RPC.
NEXT_PUBLIC_PROVIDER_URL=your_alchemy_key_here

# Optional: canonical site URL used for social preview metadata.
NEXT_PUBLIC_SITE_URL=https://nyalthe.vercel.app

# Cairo deployment (cairo/scripts/deploy-policy.sh). Keep account files and
# private keys outside the repo.
SNCAST_ACCOUNT=
EVENT_AUTHORITY_ADDRESS=
STRK20_POOL_ADDRESS=
STARKNET_NETWORK=sepolia
STARKNET_RPC_URL=
