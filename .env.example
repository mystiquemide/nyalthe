# Starknet RPC key used by the browser provider configuration.
NEXT_PUBLIC_PROVIDER_URL=your_alchemy_key_here
NEXT_PUBLIC_NYALTHE_CLAIMANT_ADDRESS=
NEXT_PUBLIC_NYALTHE_POLICY_ID=0x1
NEXT_PUBLIC_NYALTHE_PAYOUT_WEI=1000000000000000000

# Starknet network configuration
STARKNET_NETWORK=mainnet
STARKNET_RPC_URL=
STARKNET_RPC_FALLBACK_URL=

# Deployed contracts and official STRK20 integration values
NYALTHE_POLICY_CONTRACT_ADDRESS=
STRK20_POOL_ADDRESS=

# Event adapter configuration for local development only
EVENT_AUTHORITY_ADDRESS=
EVENT_AUTHORITY_PRIVATE_KEY=

# Backend deployment only. Keep account files and private keys outside the repo.
SNCAST_ACCOUNT=
